# Copy to .env for local self-hosting. Never commit real credentials.
MAX_UPLOAD_MB=50
MAX_JOB_MB=120
PDFCRAFT_CONCURRENT_JOBS=1
PDFCRAFT_REQUESTS_PER_10_MIN=20
PDFCRAFT_OPTIONS_KB=64

# Set true ONLY for disposable guest-preview hosting with ephemeral filesystem.
PDFCRAFT_EPHEMERAL_MODE=false
PDFCRAFT_DATA_DIR=./data
VAULT_TOTAL_MB=300
VAULT_FILE_MB=50
PDFCRAFT_ALLOW_REMOTE_URLS=false
PDFCRAFT_PUBLIC_URL=http://localhost:8000

# Optional SMTP password reset and notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SSL=false
SMTP_STARTTLS=true

# Optional encrypted cloud OAuth token storage. Use a strong Fernet key.
PDFCRAFT_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Optional AI / translation integrations
AI_API_KEY=
AI_MODEL=
AI_API_BASE_URL=
LIBRETRANSLATE_URL=
